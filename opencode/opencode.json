{
  "$schema": "https://opencode.ai/config.json",
  "model": "libertai/glm-5.3",
  "provider": {
    "libertai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LibertAI",
      "options": {
        "baseURL": "https://api.libertai.io/v1",
        "apiKey": "{env:LIBERTAI_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3"
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash"
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash"
        },
        "qwen-3.5-122b-a10b": {
          "name": "Qwen 3.5 122B A10B"
        },
        "qwen-3.6-45b-a3b": {
          "name": "Qwen 3.6 45B A3B"
        },
        "qwen-3.8-27b": {
          "name": "Qwen 3.8 27B"
        },
        "hermes-3-8b": {
          "name": "Hermes 3 8B"
        }
      }
    }
  }
}
