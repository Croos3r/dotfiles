#!/bin/sh
# Change volume or screen brightness and show the new level in a notification.
# Each kind reuses one notification (dunst stack tag), so holding a key
# updates it in place instead of stacking new ones.
# Usage: osd volume up|down|mute
#        osd brightness up|down
#        osd media play-pause|next|previous

VOLUME_STEP=1310   # amixer raw units, ~2%
BRIGHTNESS_STEP=5  # percent
BRIGHTNESS_MIN=1   # percent, never fully black

notify() { # tag summary percent icon
  notify-send -a osd -t 1500 -i "$4" \
    -h "string:x-dunst-stack-tag:$1" -h "int:value:$3" "$2" "$3%"
}

volume() {
  case "$1" in
    up)   amixer -q sset Master,0 "$VOLUME_STEP+" unmute ;;
    down) amixer -q sset Master,0 "$VOLUME_STEP-" unmute ;;
    mute) amixer -q sset Master,0 toggle ;;
  esac
  state=$(amixer sget Master,0)
  pct=$(printf '%s\n' "$state" | grep -o '\[[0-9]*%\]' | head -1 | tr -d '[]%')
  if printf '%s\n' "$state" | grep -q '\[off\]'; then
    notify volume "Volume (muted)" "$pct" audio-volume-muted
    return
  fi
  if   [ "$pct" -eq 0 ];  then icon=muted
  elif [ "$pct" -lt 34 ]; then icon=low
  elif [ "$pct" -lt 67 ]; then icon=medium
  else                         icon=high
  fi
  notify volume "Volume" "$pct" "audio-volume-$icon"
}

brightness() {
  dev=$(ls /sys/class/backlight | head -1)
  dir=/sys/class/backlight/$dev
  max=$(cat "$dir/max_brightness")
  cur=$(cat "$dir/brightness")
  # Work in whole percents so repeated presses land on clean steps
  pct=$(( (cur * 100 + max / 2) / max ))
  case "$1" in
    up)   pct=$((pct + BRIGHTNESS_STEP)) ;;
    down) pct=$((pct - BRIGHTNESS_STEP)) ;;
  esac
  [ "$pct" -gt 100 ] && pct=100
  [ "$pct" -lt "$BRIGHTNESS_MIN" ] && pct=$BRIGHTNESS_MIN
  # logind lets the active session set the backlight without the video group
  busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
    org.freedesktop.login1.Session SetBrightness ssu \
    backlight "$dev" $((max * pct / 100))
  notify brightness "Brightness" "$pct" display-brightness
}

# Escape text for dunst's markup (titles often contain & < >)
escape() {
  printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

# Album art as a local file: file:// URLs as-is, http(s) ones cached once.
art() {
  case "$1" in
    file://*) path=${1#file://}; [ -f "$path" ] && echo "$path" ;;
    http*://*)
      cache=${XDG_CACHE_HOME:-$HOME/.cache}/osd-art
      path=$cache/$(printf '%s' "$1" | md5sum | cut -c1-32)
      if [ ! -s "$path" ]; then
        mkdir -p "$cache"
        curl -fsL --max-time 2 -o "$path" "$1" || rm -f "$path"
      fi
      [ -s "$path" ] && echo "$path" ;;
  esac
}

media() {
  if ! playerctl status >/dev/null 2>&1; then
    notify-send -a osd-media -t 1500 -i media-playback-stop \
      -h string:x-dunst-stack-tag:media "No media player"
    return
  fi
  # The player updates asynchronously: wait (up to ~1s) for the change to land
  # so the notification shows the new state / track, not the old one.
  case "$1" in
    play-pause) watch=status ;;
    *)          watch=title ;;
  esac
  before=$(playerctl metadata --format "{{$watch}}" 2>/dev/null)
  playerctl "$1"
  i=0
  while [ $i -lt 20 ]; do
    [ "$(playerctl metadata --format "{{$watch}}" 2>/dev/null)" != "$before" ] && break
    sleep 0.05; i=$((i + 1))
  done

  status=$(playerctl status 2>/dev/null)
  # Keep long (stream) titles to about two lines
  title=$(playerctl metadata --format '{{title}}' 2>/dev/null | sed -E 's/^(.{60}).+/\1…/')
  artist=$(playerctl metadata --format '{{artist}}' 2>/dev/null)
  player=$(playerctl metadata --format '{{playerName}}' 2>/dev/null)
  case "$status" in
    Playing) glyph="󰐊"; fallback=media-playback-start ;;
    Paused)  glyph="󰏤"; fallback=media-playback-pause ;;
    *)       glyph="󰓛"; fallback=media-playback-stop ;;
  esac
  icon=$(art "$(playerctl metadata mpris:artUrl 2>/dev/null)")
  notify-send -a osd-media -t 2500 -i "${icon:-$fallback}" \
    -h string:x-dunst-stack-tag:media \
    "$glyph  $(escape "${title:-Unknown track}")" \
    "$(escape "${artist:-$player}")"
}

case "$1" in
  volume|brightness|media) "$@" ;;
  *) echo "usage: osd volume up|down|mute | brightness up|down | media play-pause|next|previous" >&2; exit 1 ;;
esac
