#!/usr/bin/env python3
# Lock with a blurred, dimmed snapshot of each output (replaces i3lock-fancy).
# Falls back to plain swaylock if anything goes wrong, so the screen always locks.

import json
import os
import subprocess
import sys
import tempfile

from PIL import Image, ImageEnhance, ImageFilter

DOWNSCALE = 6    # blur a smaller copy: much faster and smoother than a huge radius
RADIUS = 4
BRIGHTNESS = 0.7
# swaylock-fprintd fork, built in ~/projects/swaylock-fprintd; -p unlocks by fingerprint alongside the password prompt.
SWAYLOCK = os.path.expanduser('~/.local/bin/swaylock-fprintd')


def blurred_snapshots(tmpdir):
    outputs = json.loads(subprocess.check_output(['swaymsg', '-t', 'get_outputs', '-r']))
    args = []
    for output in outputs:
        if not output.get('active'):
            continue
        name = output['name']
        raw = os.path.join(tmpdir, f'{name}.ppm')
        path = os.path.join(tmpdir, f'{name}.png')
        # Uncompressed PPM in, uncompressed PNG out: grim's PNG encoding alone takes ~1s on a HiDPI screen.
        subprocess.run(['grim', '-t', 'ppm', '-o', name, raw], check=True)
        with Image.open(raw) as img:
            size = img.size
            small = img.convert('RGB').resize((max(1, size[0] // DOWNSCALE), max(1, size[1] // DOWNSCALE)), Image.BILINEAR)
            small = small.filter(ImageFilter.GaussianBlur(RADIUS))
            small = ImageEnhance.Brightness(small).enhance(BRIGHTNESS)
            small.resize(size, Image.BICUBIC).save(path, compress_level=0)
        args += ['-i', f'{name}:{path}']
    return args


def main():
    # Already locked: a snapshot now would just capture the lock screen.
    # The kernel truncates process names to 15 chars: swaylock-fprintd shows up as swaylock-fprint.
    if subprocess.run(['pgrep', '-x', 'swaylock|swaylock-fprint'], stdout=subprocess.DEVNULL).returncode == 0:
        return 0

    tmpdir = tempfile.mkdtemp(prefix='blur-lock-', dir=os.environ.get('XDG_RUNTIME_DIR'))
    try:
        images = blurred_snapshots(tmpdir)
    except Exception as e:
        print(f'blur-lock: {e}, locking without blur', file=sys.stderr)
        images = []

    # Not -f: forking after gdk-pixbuf has loaded the images breaks GLib's D-Bus in the child, so the
    # fingerprint code hangs ~25s and then gives up. Instead leave swaylock running and return once
    # --ready-fd reports the lock is in place, so swayidle's before-sleep still blocks suspend until locked.
    ready_r, ready_w = os.pipe()
    proc = subprocess.Popen([SWAYLOCK, '-p', '--ready-fd', str(ready_w), *images, *sys.argv[1:]],
                            pass_fds=(ready_w,), start_new_session=True)
    os.close(ready_w)
    ready = os.read(ready_r, 1)  # empty if swaylock exits without locking
    os.close(ready_r)
    # swaylock has loaded the images by the time it locks.
    for f in os.listdir(tmpdir):
        os.remove(os.path.join(tmpdir, f))
    os.rmdir(tmpdir)
    return 0 if ready else proc.wait()


if __name__ == '__main__':
    sys.exit(main())
